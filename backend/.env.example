# ResiliChain AI - environment configuration
# Copy to `.env` and adjust values for your environment.

# --- Application ---
PROJECT_NAME="ResiliChain AI"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (async driver required) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resilichain

# Create tables automatically on startup (dev convenience; use Alembic in production)
AUTO_CREATE_TABLES=true

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma separated origins, or *) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting (ready, disabled by default) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
